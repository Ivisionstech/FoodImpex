    }

    /**
     * Process Debit with Due Management
     */
    private function processDebitWithDue($type, $id, $amount, $date, $description)
    {
        Log::info("=== processDebitWithDue called ===");
        Log::info("Type: {$type}, ID: {$id}, Amount: {$amount}");
        
        switch ($type) {
            case 'customer':
                $customer = Customer::find($id);
                if (!$customer) {
                    Log::error("Customer not found with ID: {$id}");
                    return;
                }
                
                $currentBalance = floatval($customer->balance);
                Log::info("Customer {$customer->name} - Current Balance: {$currentBalance}");
                
                // Debit the amount
                $newBalance = $currentBalance - $amount;
                $customer->balance = $newBalance;
                $customer->save();
                
                Log::info("Customer {$customer->name} - New Balance: {$newBalance}");
                
                // Create transaction record
                CustomerTransaction::create([
                    'uuid' => Str::uuid(),
                    'customer_id' => $customer->id,
                    'transaction_date' => $date,
                    'amount' => $amount,
                    'type' => 'debit',
                    'approval_status' => 'approved',
                    'description' => 'Debit Entry: ' . $description,
                    'current_balance' => $newBalance,
                ]);
                
                // If balance became negative, create DUE entry
                if ($newBalance < 0) {
                    $dueAmount = abs($newBalance);
                    Log::info("Balance negative, creating due entry for: {$dueAmount}");
                    $this->createDueEntry($type, $id, $dueAmount, $date, $description);
                }
                break;
                
            case 'vendor':
                $vendor = Vendor::find($id);
                if (!$vendor) {
                    Log::error("Vendor not found with ID: {$id}");
                    return;
                }
                
                $currentBalance = floatval($vendor->balance);
                Log::info("Vendor {$vendor->company_name} - Current Balance: {$currentBalance}");
                
                $newBalance = $currentBalance - $amount;
                $vendor->balance = $newBalance;
                $vendor->save();
                
                VendorTransaction::create([
                    'uuid' => Str::uuid(),
                    'vendor_id' => $vendor->id,
                    'date' => $date,
                    'amount' => (string)$amount,
                    'type' => 'debit',
                    'approval_status' => 'approved',
                    'description' => 'Debit Entry: ' . $description,
                    'current_balance' => (string)$newBalance,
                ]);
                
                if ($newBalance < 0) {
                    $dueAmount = abs($newBalance);
                    $this->createDueEntry($type, $id, $dueAmount, $date, $description);
                }
                break;
                
            case 'bank':
                $bank = Bank::find($id);
                if (!$bank) {
                    Log::error("Bank not found with ID: {$id}");
                    return;
                }
                
                $currentBalance = floatval($bank->account_balance);
                $newBalance = $currentBalance - $amount;
                $bank->account_balance = $newBalance;
                $bank->save();
                
                BankTransaction::create([
                    'bank_id' => $bank->id,
                    'amount' => $amount,
                    'balance' => $newBalance,
                    'transaction_type' => 'debit',
                    'description' => 'Debit Entry: ' . $description,
                ]);
                
                if ($newBalance < 0) {
                    $dueAmount = abs($newBalance);
                    $this->createDueEntry($type, $id, $dueAmount, $date, $description);
                }
                break;
                
            case 'cash':
                $cash = Cash::find($id);
                if (!$cash) {
                    Log::error("Cash not found with ID: {$id}");
                    return;
                }
                
                $currentBalance = floatval($cash->balance);
                $newBalance = $currentBalance - $amount;
                $cash->balance = $newBalance;
                $cash->save();
                
                CashTransaction::create([
                    'cash_id' => $cash->id,
                    'amount' => $amount,
                    'balance' => $newBalance,
                    'transaction_type' => 'debit',
                    'description' => 'Debit Entry: ' . $description,
                ]);
                
                if ($newBalance < 0) {
                    $dueAmount = abs($newBalance);
                    $this->createDueEntry($type, $id, $dueAmount, $date, $description);
                }
                break;
        }
    }

    /**
     * Create Due Entry
     */
    private function createDueEntry($type, $id, $amount, $date, $description)
    {
        if ($amount <= 0) {
            Log::info("createDueEntry: Amount <= 0, skipping");
            return;
        }
        
        Log::info("=== createDueEntry called ===");
        
        // Create daybook due entry with explicit status = 1
        $dueEntry = Daybook::create([
            'transaction_date' => $date,
            'amount' => $amount,
            'status' => 1,  // Explicitly set status
            'type' => 'transaction',
            'approval_status' => 'pending',
            'debit_type' => $type,
            'debit_id' => $id,
            'description' => 'DUE: ' . $description . ' (Outstanding amount to be paid)',
        ]);
        
        Log::info("Due Daybook entry created with ID: {$dueEntry->id}");
    }

    /**
     * Delete a pending entry
     */
    public function deleteEntry($id)
    {
        if (!$this->isAdmin()) {
            return response()->json([
                'success' => false,
                'message' => 'Access Denied.'
            ], 403);
        }
        
        try {
            $entry = Daybook::findOrFail($id);
            $entry->delete();
            
            return response()->json([
                'success' => true,
                'message' => 'Entry deleted successfully.'
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => $e->getMessage()
            ], 500);
        }
    }

