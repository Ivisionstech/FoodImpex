    /**
     * Display entries list
     */
    public function generalEntriesList(Request $request)
    {
        try {
            $query = Daybook::where('type', 'transaction');
            
            if ($request->approval_status && in_array($request->approval_status, ['pending', 'approved'])) {
                $query->where('approval_status', $request->approval_status);
            }
            
            if ($request->amount_type) {
                if ($request->amount_type == 'credit') {
                    $query->whereNotNull('credit_type');
                } elseif ($request->amount_type == 'debit') {
                    $query->whereNotNull('debit_type');
                } elseif ($request->amount_type == 'due') {
                    $query->where('description', 'LIKE', '%DUE:%');
                }
            }
            
            if ($request->from_date) {
                $query->whereDate('transaction_date', '>=', $request->from_date);
            }
            if ($request->to_date) {
                $query->whereDate('transaction_date', '<=', $request->to_date);
            }
            
            $perPage = $request->per_page ?? 10;
            $entries = $query->orderBy('transaction_date', 'desc')
                ->orderBy('id', 'desc')
                ->paginate($perPage);
            
            return view('admin.pages.general.entries-list', compact('entries'));
        } catch (\Exception $e) {
            \Log::error('Error in generalEntriesList: ' . $e->getMessage());
            return redirect()->back()->with('error', 'Failed to load entries: ' . $e->getMessage());
        }
    }

    /**
     * Get single entry details
     */
    public function getEntry($id)
    {
        try {
            $entry = Daybook::findOrFail($id);
            
            $accountName = '';
            $accountType = '';
            $isDebit = $entry->debit_type && $entry->debit_id;
            $isCredit = $entry->credit_type && $entry->credit_id;
            
            if ($isDebit) {
                $accountType = $entry->debit_type;
                if ($accountType == 'customer') {
                    $customer = Customer::find($entry->debit_id);
                    $accountName = $customer ? $customer->name : 'Customer #' . $entry->debit_id;
                } elseif ($accountType == 'vendor') {
                    $vendor = Vendor::find($entry->debit_id);
                    $accountName = $vendor ? $vendor->company_name : 'Vendor #' . $entry->debit_id;
                } elseif ($accountType == 'bank') {
                    $bank = Bank::find($entry->debit_id);
                    $accountName = $bank ? $bank->name : 'Bank #' . $entry->debit_id;
                } elseif ($accountType == 'cash') {
                    $accountName = 'Cash Account';
                }
            } elseif ($isCredit) {
                $accountType = $entry->credit_type;
                if ($accountType == 'customer') {
                    $customer = Customer::find($entry->credit_id);
                    $accountName = $customer ? $customer->name : 'Customer #' . $entry->credit_id;
                } elseif ($accountType == 'vendor') {
                    $vendor = Vendor::find($entry->credit_id);
                    $accountName = $vendor ? $vendor->company_name : 'Vendor #' . $entry->credit_id;
                } elseif ($accountType == 'bank') {
                    $bank = Bank::find($entry->credit_id);
                    $accountName = $bank ? $bank->name : 'Bank #' . $entry->credit_id;
                } elseif ($accountType == 'cash') {
                    $accountName = 'Cash Account';
                }
            }
            
            $html = '
            <div class="p-3">
                <table class="table table-bordered">
                    <tr>
                        <th width="30%">Transaction Date</th>
                        <td>' . date('d-M-Y h:i A', strtotime($entry->transaction_date)) . '</td>
                    </tr>
                    <tr>
                        <th>Amount</th>
                        <td class="fw-bold ' . ($isDebit ? 'text-danger' : 'text-success') . '">PKR ' . number_format($entry->amount, 2) . '</td>
                    </tr>
                    <tr>
                        <th>Type</th>
                        <td>' . ($isDebit ? 'Debit' : ($isCredit ? 'Credit' : 'N/A')) . '</td>
                    </tr>
                    <tr>
                        <th>Account Type</th>
                        <td>' . ucfirst($accountType) . '</td>
                    </tr>
                    <tr>
                        <th>Account Name</th>
                        <td>' . e($accountName) . '</td>
                    </tr>
                    <tr>
                        <th>Approval Status</th>
                        <td><span class="badge bg-' . ($entry->approval_status == 'approved' ? 'success' : 'warning') . '">' . ucfirst($entry->approval_status) . '</span></td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>' . e($entry->description ?? 'N/A') . '</td>
                    </tr>
                    <tr>
                        <th>Created At</th>
                        <td>' . date('d-M-Y h:i A', strtotime($entry->created_at)) . '</td>
                    </tr>
                </table>
            </div>';
            
            return response()->json(['html' => $html]);
            
        } catch (\Exception $e) {
            return response()->json(['html' => '<div class="alert alert-danger">Error: ' . $e->getMessage() . '</div>'], 500);
        }
    }

    /**
     * Get accounts for AJAX
     */
    public function getAccounts(Request $request)
    {
        $type = $request->type;
        $accounts = [];
        
        switch($type) {
            case 'customer':
                $accounts = Customer::select('id', 'name', 'phone', 'balance')
                    ->where('active', 1)
                    ->orderBy('name')
                    ->get()
                    ->map(function($item) {
                        return [
                            'id' => $item->id,
                            'name' => $item->name,
                            'display_name' => $item->name . ($item->phone ? ' - ' . $item->phone : ''),
                            'balance' => $item->balance,
                            'type' => 'customer'
                        ];
                    });
                break;
                
            case 'vendor':
                $accounts = Vendor::select('id', 'company_name', 'phone', 'balance')
                    ->where('active', 1)
                    ->orderBy('company_name')
                    ->get()
                    ->map(function($item) {
                        return [
                            'id' => $item->id,
                            'name' => $item->company_name,
                            'display_name' => $item->company_name,
                            'balance' => $item->balance,
                            'type' => 'vendor'
                        ];
                    });
                break;
                
            case 'bank':
                $accounts = Bank::select('id', 'name', 'account_number', 'account_balance as balance')
                    ->orderBy('name')
                    ->get()
                    ->map(function($item) {
                        return [
                            'id' => $item->id,
                            'name' => $item->name,
                            'display_name' => $item->name . ' - ' . $item->account_number,
                            'balance' => $item->balance,
                            'type' => 'bank'
                        ];
                    });
                break;
                
            case 'cash':
                $cash = Cash::first();
                $accounts = [
                    [
                        'id' => 1,
                        'name' => 'Main Cash',
                        'display_name' => 'Cash Account',
                        'balance' => $cash ? $cash->balance : 0,
                        'type' => 'cash'
                    ]
                ];
                break;
                
            case 'expense':
                $accounts = \App\Models\Expense::select('id', 'name')
                    ->orderBy('name')
                    ->get()
                    ->map(function($item) {
                        return [
                            'id' => $item->id,
                            'name' => $item->name,
                            'display_name' => $item->name . ' (Expense)',
                            'balance' => 0,
                            'type' => 'expense'
                        ];
                    });
                break;
        }
        
        return response()->json($accounts);
    }

