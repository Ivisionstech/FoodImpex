     private function isAdmin()
    {
        $user = auth()->user();
        $isAdmin = $user && $user->role == 'admin';
        Log::info("User role check: " . ($user ? $user->role : 'no user') . ", Is Admin: " . ($isAdmin ? 'Yes' : 'No'));
        return $isAdmin;
    }

    /**
     * Approve a pending general entry
     */
    public function approveEntry($id)
    {
        if (!$this->isAdmin()) {
            return response()->json([
                'success' => false,
                'message' => 'Access Denied. Only Admin can approve entries.'
            ], 403);
        }

        try {
            DB::beginTransaction();
            
            $entry = Daybook::findOrFail($id);
            
            if ($entry->approval_status === 'approved') {
                return response()->json([
                    'success' => false,
                    'message' => 'Entry already approved.'
                ], 400);
            }
            
            $amount = $entry->amount;
            $date = $entry->transaction_date;
            $description = $entry->description ?? '';
            
            // Check if this is a DUE entry (pending due)
            $isDue = strpos($description, 'DUE:') !== false;
            
            if ($isDue) {
                // Process due payment
                $this->processDuePayment($entry->debit_type, $entry->debit_id, $amount, $date, $description);
            } else {
                // Process normal Credit/Debit transaction
                if ($entry->credit_type && $entry->credit_id) {
                    $this->processCredit($entry->credit_type, $entry->credit_id, $amount, $date, $description);
                }
                
                if ($entry->debit_type && $entry->debit_id) {
                    $this->processDebitWithDue($entry->debit_type, $entry->debit_id, $amount, $date, $description);
                }
            }
            
            $entry->approval_status = 'approved';
            $entry->save();
            
            DB::commit();
            
            $message = $isDue ? 'Due payment processed successfully!' : 'Entry approved successfully!';
            return response()->json([
                'success' => true,
                'message' => $message
            ]);
            
        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Approve Entry Error: ' . $e->getMessage());
            return response()->json([
                'success' => false,
                'message' => 'Approval failed: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Process Due Payment
     */
    private function processDuePayment($type, $id, $amount, $date, $description)
    {
        Log::info("=== processDuePayment called ===");
        
        switch ($type) {
            case 'customer':
                $customer = Customer::findOrFail($id);
                $oldBalance = $customer->balance;
                $customer->decrement('balance', $amount);
                
                CustomerTransaction::create([
                    'uuid' => Str::uuid(),
                    'customer_id' => $customer->id,
                    'transaction_date' => $date,
                    'amount' => $amount,
                    'type' => 'payment',
                    'approval_status' => 'approved',
                    'description' => 'Due Payment: ' . str_replace('DUE:', '', $description),
                    'current_balance' => $customer->balance,
                ]);
                
                Log::info("Due Payment: Customer {$customer->name} balance: {$oldBalance} -> {$customer->balance}");
                break;
                
            case 'vendor':
                $vendor = Vendor::findOrFail($id);
                $oldBalance = $vendor->balance;
                $vendor->decrement('balance', $amount);
                
                VendorTransaction::create([
                    'uuid' => Str::uuid(),
                    'vendor_id' => $vendor->id,
                    'date' => $date,
                    'amount' => (string)$amount,
                    'type' => 'payment',
                    'approval_status' => 'approved',
                    'description' => 'Due Payment: ' . str_replace('DUE:', '', $description),
                    'current_balance' => (string)$vendor->balance,
                ]);
                Log::info("Due Payment: Vendor {$vendor->company_name} balance: {$oldBalance} -> {$vendor->balance}");
                break;
                
            case 'bank':
                $bank = Bank::findOrFail($id);
                $oldBalance = $bank->account_balance;
                $bank->decrement('account_balance', $amount);
                
                BankTransaction::create([
                    'bank_id' => $bank->id,
                    'amount' => $amount,
                    'balance' => $bank->account_balance,
                    'transaction_type' => 'debit',
                    'description' => 'Due Payment: ' . str_replace('DUE:', '', $description),
                ]);
                Log::info("Due Payment: Bank {$bank->name} balance: {$oldBalance} -> {$bank->account_balance}");
                break;
                
            case 'cash':
                $cash = Cash::findOrFail($id);
                $oldBalance = $cash->balance;
                $cash->decrement('balance', $amount);
                
                CashTransaction::create([
                    'cash_id' => $cash->id,
                    'amount' => $amount,
                    'balance' => $cash->balance,
                    'transaction_type' => 'debit',
                    'description' => 'Due Payment: ' . str_replace('DUE:', '', $description),
                ]);
                Log::info("Due Payment: Cash balance: {$oldBalance} -> {$cash->balance}");
                break;
        }
    }

