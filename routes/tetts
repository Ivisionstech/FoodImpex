    public function customerToVendorTransfer(Request $request)
    {
        $request->validate([
            'customer_id' => 'required|exists:customers,id',
            'vendor_id' => 'required|exists:vendors,id',
            'amount' => 'required|numeric|min:0.01',
            'transaction_date' => 'required|date',
        ]);

        try {
            DB::beginTransaction();
            
            $customer = Customer::findOrFail($request->customer_id);
            $vendor = Vendor::findOrFail($request->vendor_id);
            $isAdmin = auth()->user()->role == 'admin';
            $status = $isAdmin ? 'approved' : 'pending';

            $daybook = Daybook::create([
                'transaction_date' => $request->transaction_date,
                'amount' => $request->amount,
                'status' => 1,
                'type' => 'transaction',
                'approval_status' => $status,
                'credit_type' => 'customer',
                'credit_id' => $customer->id,
                'debit_type' => 'vendor',
                'debit_id' => $vendor->id,
                'description' => 'Transfer from ' . $customer->name . ' to ' . $vendor->company_name,
            ]);

            if ($isAdmin) {
                $this->processCredit('customer', $customer->id, $request->amount, $request->transaction_date, 'Transfer to vendor');
                $this->processDebitWithDue('vendor', $vendor->id, $request->amount, $request->transaction_date, 'Transfer from customer');
            }
            
            DB::commit();

            $msg = $isAdmin ? 'Transfer completed successfully!' : 'Transfer request created! Awaiting admin approval.';
            return redirect()->route('general-transactions.index')->with('success', $msg);
        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Customer to Vendor Transfer Error: ' . $e->getMessage());
            return redirect()->back()->with('error', 'Failed: ' . $e->getMessage());
        }
    }

